# Copy this file to .env and replace the placeholders using Neon > Connect.
# Use the pooled connection string when available, and retain sslmode=require.
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<neon-username>
SPRING_DATASOURCE_PASSWORD=<neon-password>
TASKFLOW_JWT_SECRET=<at-least-32-random-characters>
